# Copy file này thành .env.local rồi điền giá trị thật.
# .env.local đã nằm trong .gitignore — KHÔNG bao giờ commit token lên GitHub.

# Username GitHub dùng để kéo repository (không phải URL, chỉ tên).
GITHUB_USERNAME=

# Personal Access Token của GitHub, loại fine-grained, chỉ cần quyền đọc public repo.
# Bắt buộc phải có: GitHub GraphQL API luôn yêu cầu token, kể cả với dữ liệu công khai.
# Tạo tại: https://github.com/settings/personal-access-tokens
# Token này chỉ chạy phía server, không bao giờ lộ ra trình duyệt.
GITHUB_TOKEN=

# URL production, KHÔNG có dấu / ở cuối. Dùng cho metadata, sitemap, hreflang.
# Ví dụ: https://hoangan.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
